 '</g></svg>';
function paintGlass(root){
  var hosts=(root||document).querySelectorAll(".glasshost,.tile,.mav");
  for(var i=0;i<hosts.length;i++){
    if(hosts[i].querySelector(".glass")) continue;
    hosts[i].insertAdjacentHTML("afterbegin",GLASS);
  }
}
paintGlass(document);

/* ------------------------------------------------------------------ */
var VERDICT={
  landed:{label:"Landed",color:"#00FF7F",bg:"rgba(0,255,127,0.12)"},
  open:{label:"Open",color:"#F59E0B",bg:"rgba(245,158,11,0.12)"},
  unmeasurable:{label:"Unmeasurable",color:"#6B7280",bg:"rgba(107,114,128,0.12)"},
  unanswered:{label:"Unanswered",color:"#7CFF9B",bg:"rgba(124,255,155,0.12)"}
};
var RAILCOLOR={bee:"#00FFC2",in:"#7CFF9B",typed:"#00FF7F",omi:"#F59E0B",sms:"#6B7280",
               mail:"#6B7280",note:"#6B7280"};
function verdict(s){ return VERDICT[s]||VERDICT.unmeasurable; }

var D=null, sel=null, view="Journals", q="", chip=null, kopen=false, toastT=0, lastGen="";

function todayISO(){
  var d=new Date(), p=function(n){return (n<10?"0":"")+n;};
  return d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate());
}
function dayLabel(iso){
  if(!iso) return "";
  var p=String(iso).split("-");
  var dt=new Date(+p[0],+p[1]-1,+p[2]);
  var t=new Date(); t.setHours(0,0,0,0);
  var diff=Math.round((t-dt)/86400000);
  if(diff===0) return "Today";
  if(diff===1) return "Yesterday";
  if(diff>1&&diff<7) return "Earlier";
  return "Archive";
}
function dateLabel(iso){
  if(!iso) return "";
  var p=String(iso).split("-");
  var dt=new Date(+p[0],+p[1]-1,+p[2]);
  var s=dt.toLocaleDateString(undefined,{month:"short",day:"2-digit"});
  var d=dayLabel(iso);
  return (d==="Today"||d==="Yesterday")? (s+" · "+d) : s;
}

/* derive a title + preview from the block's OWN published lines. never invented. */
function derive(b){
  var pub=[], red=0;
  var ls=b.lines||[];
  for(var i=0;i<ls.length;i++){
    if(ls[i].redacted || !ls[i].text){ red++; continue; }
    var e=emit(ls[i].text);
    if(e.ok) pub.push(e.text); else red++;
  }
  var title = pub.length? pub[0] : null;
  var prev  = pub.length>1? pub.slice(1,4).join(" · ") : null;
  return {title:title, preview:prev, pub:pub.length, red:red};
}
function blockTags(b){
  var t=[], seen={}, ls=b.lines||[];
  for(var i=0;i<ls.length;i++){ var r=ls[i].rail; if(r&&!seen[r]){seen[r]=1;t.push("#"+tok(r));} }
  var bc=b.became||[];
  for(var j=0;j<bc.length && t.length<6;j++){
    t.push("#"+tok(String(bc[j].label||"").replace(/\s+/g,"-"))+" "+num(bc[j].n));
  }
  return t;
}
function blocks(){ return (D&&D.blocks)?D.blocks:[]; }

function visible(){
  var out=blocks().slice();
  if(view==="Archive"){ var t=todayISO(); out=out.filter(function(b){return b.day!==t;}); }
  if(chip){
    out=out.filter(function(b){
      if(VERDICT[chip]) return (b.status||"unmeasurable")===chip;
      var ls=b.lines||[];
      for(var i=0;i<ls.length;i++){ if(ls[i].rail===chip) return true; }
      return false;
    });
  }
  if(q){
    var s=q.toLowerCase();
    out=out.filter(function(b){
      var d=derive(b);
      var hay=((d.title||"")+" "+(d.preview||"")+" "+blockTags(b).join(" ")+" "+(b.day||"")).toLowerCase();
      return hay.indexOf(s)>=0;
    });
  }
  return out;
}
function current(){
  var v=visible();
  if(!v.length) return null;
  for(var i=0;i<v.length;i++){ if(v[i].ts===sel) return v[i]; }
  return v[0];
}

/* ---------------- toast ---------------- */
function say(msg){
  var el=$("toast");
  if(!el){ el=document.createElement("div"); el.className="toast"; el.id="toast";
    el.innerHTML='<i></i><span></span>'; document.body.appendChild(el); }
  el.querySelector("span").textContent=msg;
  el.style.display="flex";
  clearTimeout(toastT);
  toastT=setTimeout(function(){ el.style.display="none"; },2600);
}

/* ---------------- header nav ---------------- */
function navItems(){
  var t=(D&&D.totals)||{};
  var arch=blocks().filter(function(b){return b.day!==todayISO();}).length;
  return [
    {k:"Journals",count:blocks().length},
    {k:"Mentors",count:0},
    {k:"Insights",count:null},
    {k:"Archive",count:arch}
  ];
}
function renderNav(){
  var items=navItems(), h="", m="";
  for(var i=0;i<items.length;i++){
    var it=items[i], on=(view===it.k);
    h+='<button class="navbtn'+(on?" on":"")+'" data-k="'+it.k+'">'+it.k+
       (it.count?'<span class="badge">'+num(it.count)+'</span>':'')+'</button>';
    m+='<button class="'+(on?"on":"")+'" data-k="'+it.k+'">'+it.k+'</button>';
  }
  $("nav").innerHTML=h; $("mnav").innerHTML=m;
}

/* ---------------- filter chips ---------------- */
function renderChips(){
  var bs=blocks(), counts={landed:0,open:0,unmeasurable:0,unanswered:0}, rails={};
  for(var i=0;i<bs.length;i++){
    var st=bs[i].status||"unmeasurable";
    counts[st]=(counts[st]||0)+1;
    var ls=bs[i].lines||[];
    for(var j=0;j<ls.length;j++){ var r=ls[j].rail; if(r) rails[r]=(rails[r]||0)+1; }
  }
  var h='<button class="chip'+(chip?"":" on")+'" data-c="">All</button>';
  var order=["landed","open","unanswered","unmeasurable"];
  for(var k=0;k<order.length;k++){
    var key=order[k]; if(!counts[key]) continue;
    var v=VERDICT[key];
    h+='<button class="chip'+(chip===key?" on":"")+'" data-c="'+key+'">'+
       '<span class="d" style="background:'+v.color+';box-shadow:0 0 8px '+v.color+'"></span>'+
       v.label+'<span class="n">'+num(counts[key])+'</span></button>';
  }
  var rk=Object.keys(rails).sort(function(a,b){return rails[b]-rails[a];});
  for(var r2=0;r2<rk.length;r2++){
    var name=rk[r2], c=RAILCOLOR[name]||"#6B7280";
    h+='<button class="chip'+(chip===name?" on":"")+'" data-c="'+tok(name)+'">'+
       '<span class="d" style="background:'+c+';box-shadow:0 0 8px '+c+'"></span>'+
       tok(name)+'<span class="n">'+num(rails[name])+'</span></button>';
  }
  $("chips").innerHTML=h;
  $("chiphint").innerHTML="verdict and rail are the real categories in this record. "+
    "no emotion model is wired over his speech, so none is shown.";
}

/* ---------------- journal cards ---------------- */
function renderList(){
  var v=visible();
  $("lheadt").innerHTML="JOURNALS &middot; "+num(v.length);
  $("lheadr").textContent = (D&&D.totals)? (num(D.totals.blocks)+" total") : "";
  if(!v.length){
    $("cards").innerHTML='<div class="empty">'+
      (blocks().length? ("No block matches &ldquo;"+esc(q||chip||view)+"&rdquo;.")
                      : "No blocks in the feed yet. Nothing is being invented to fill this.")+'</div>';
  } else {
    var h="", curTs=(current()||{}).ts;
    for(var i=0;i<v.length;i++){
      var b=v[i], on=(b.ts===curTs), d=derive(b), vd=verdict(b.status);
      var title = d.title!=null? esc(d.title) : '<span style="color:rgba(255,255,255,.35);font-style:italic">Every line in this block was withheld</span>';
      var prev  = d.preview!=null? esc(d.preview)
                : (d.pub? '<span style="font-style:italic">no further published line in this sample</span>'
                        : '<span style="font-style:italic">'+num(d.red)+' line'+(d.red===1?"":"s")+' withheld by the screen</span>');
      var tags=blockTags(b), tg="";
      for(var t2=0;t2<tags.length;t2++) tg+='<span class="tag">'+tags[t2]+'</span>';
      h+='<div class="card'+(on?" on":"")+'" role="button" tabindex="0" data-ts="'+esc(b.ts)+'">'+
         (on?'<span class="lit"><span class="glasshost" style="position:absolute;inset:0"></span><span class="grad"></span></span>':'')+
         '<span class="cbody">'+
           '<span class="crow">'+
             '<span class="cdate">'+esc(dateLabel(b.day))+'</span>'+
             '<span class="cdiv"></span>'+
             '<span class="ctime">'+esc(b.start||"")+'&ndash;'+esc(b.end||"")+'</span>'+
             '<span class="pill" style="border-color:'+vd.color+'30;background:'+vd.bg+';color:'+vd.color+'">'+
               '<span class="d" style="background:'+vd.color+'"></span>'+vd.label+'</span>'+
           '</span>'+
           '<span class="ctitle">'+title+'</span>'+
           '<span class="cprev">'+prev+'</span>'+
           '<span class="ctags">'+tg+'</span>'+
         '</span></div>';
    }
    $("cards").innerHTML=h;
    paintGlass($("cards"));
  }
  var t=(D&&D.totals)||{};
  $("lfootl").textContent=num(blocks().length)+" blocks · "+num(t.breaths_qi||0)+" breaths";
  $("lfootr").textContent=num(t.redacted_lines||0)+" withheld · redacted by default";
}

/* ---------------- editor ---------------- */
function renderEditor(){
  var b=current();
  if(!b){
    $("crumbday").textContent="—";
    $("eheadpills").innerHTML="";
    $("edate").textContent="—";
    $("etitle").className="etitle ghost";
    $("etitle").textContent = blocks().length? "Nothing matches this filter" : "No record yet";
    $("etext").innerHTML='<div class="empty">'+
      (blocks().length? "Clear the filter to read a block."
       : "The feed carries no blocks. This pane stays empty rather than showing something he never said.")+'</div>';
    $("echips").innerHTML="";
    renderMentor(null);
    return;
  }
  var vd=verdict(b.status), d=derive(b);
  $("crumbday").textContent=dayLabel(b.day).toUpperCase();
  var landed=b.landed_lines||0, n=b.n_lines||0;
  var pct=n? Math.round(landed/n*100):0;
  $("eheadpills").innerHTML=
    '<span class="epill" style="border-color:'+vd.color+'25;background:'+vd.bg+';color:'+vd.color+'">'+
      '<span class="d" style="background:'+vd.color+';box-shadow:0 0 10px '+vd.color+'"></span>'+
      vd.label+' · '+num(landed)+'/'+num(n)+' landed</span>'+
    '<span class="mpill md">'+num(b.n_actions||0)+' actions · '+num(b.verified||0)+' verified</span>';
  $("edate").textContent=(dateLabel(b.day)+" · "+(b.start||"")+"–"+(b.end||"")).toUpperCase();
  if(d.title!=null){ $("etitle").className="etitle"; $("etitle").textContent=d.title; }
  else { $("etitle").className="etitle ghost"; $("etitle").textContent="Every line in this block was withheld"; }

  var ls=b.lines||[], h="";
  for(var i=0;i<ls.length;i++){
    var L=ls[i], e=emit(L.text), st=L.st||"", c=(st==="landed")?"#00FF7F":(st==="open")?"#F59E0B":"#6B7280";
    var rail=tok(L.rail||"");
    h+='<div class="eline"><div class="lt">'+esc(L.t||"")+'</div><div class="lx'+(e.ok?"":" red")+'">'+
       '<span class="dotm" style="background:'+c+';box-shadow:0 0 6px '+c+'"></span>'+
       (rail?'<span class="railtag '+rail+'">'+rail+'</span>':'')+
       (e.ok? e.html : '&mdash; withheld ('+num(L.n||e.len||0)+' chars) &mdash;')+
       '</div></div>';
  }
  if(!ls.length) h='<div class="empty">This block carries no sampled lines.</div>';
  if(ls.length<n){
    h+='<div class="eline"><div class="lt"></div><div class="lx" style="color:rgba(255,255,255,.28);font-style:italic;font-size:14px">'+
       'showing '+num(ls.length)+' of '+num(n)+' lines in this block</div></div>';
  }
  $("etext").innerHTML=h;

  var bc=b.became||[], ch=
    '<span class="metric"><span class="i">&#9679;</span>'+
    num(landed)+' of '+num(n)+' lines landed'+
    '<span class="bar"><i style="width:'+pct+'%"></i></span></span>';
  for(var j=0;j<bc.length;j++) ch+='<span class="etag">'+tok(bc[j].label)+' ×'+num(bc[j].n)+'</span>';
  if(!bc.length) ch+='<span class="etag">nothing linked to this block yet</span>';
  $("echips").innerHTML=ch;
  renderMentor(b);
}

/* mentor: honest empty state — no mentor rail exists over his record */
function renderMentor(b){
  $("mentor").innerHTML=
    '<div class="mempty"><span class="ic">&#9675;</span>'+
    '<span>No mentor is wired to this record &mdash; nothing has ever responded to these lines.</span>'+
    '<button class="mbtn" id="mbtn">Invoke mentor</button></div>';
  var mb=$("mbtn");
  if(mb) mb.addEventListener("click",function(){ say("No mentor rail is wired yet — nothing to invoke."); });
}

/* ---------------- insights / mentors views ---------------- */
function renderInsights(){
  var t=(D&&D.totals)||{}, rails=(D&&D.rails)||[], open=(D&&D.open)||[], rr=(D&&D.redact_reasons)||[];
  var h='<div class="secthead">THE COUNTS</div><div class="grid">';
  var cells=[["breaths_qi","breaths (his)"],["utterances","utterances"],["blocks","blocks"],
             ["actions","actions"],["verified","verified"],["pending","pending"],
             ["open_breaths","never became anything"],["redacted_lines","lines withheld"]];
  for(var i=0;i<cells.length;i++){
    if(t[cells[i][0]]===undefined) continue;
    var col=(cells[i][0]==="verified")?"#00FF7F":(cells[i][0]==="open_breaths")?"#F59E0B":"#E8EAE8";
    h+='<div class="cellv"><div class="n" style="color:'+col+'">'+num(t[cells[i][0]])+'</div>'+
       '<div class="l">'+cells[i][1]+'</div></div>';
  }
  h+='</div>';
  if(rails.length){
    h+='<div class="secthead" style="margin-top:16px">RAILS</div><div class="chips">';
    for(var r=0;r<rails.length;r++){
      var c=RAILCOLOR[rails[r].rail]||"#6B7280";
      h+='<span class="chip"><span class="d" style="background:'+c+';box-shadow:0 0 8px '+c+'"></span>'+
         tok(rails[r].rail)+'<span class="n">'+num(rails[r].n)+'</span></span>';
    }
    h+='</div>';
  }
  h+='<div class="secthead" style="margin-top:16px">WHAT NEVER BECAME ANYTHING &middot; '+num(open.length)+'</div>'+
     '<p class="lede">Every line here is something he said that no action was ever linked to. '+
     'It is the section that matters.</p>';
  if(!open.length){ h+='<div class="empty">Nothing open in this feed.</div>'; }
  else{
    for(var o=0;o<open.length && o<60;o++){
      var e=emit(open[o].text);
      h+='<div class="openrow"><div class="w">'+esc(dateLabel(open[o].day))+'<br>'+esc(open[o].t||"")+'</div>'+
         '<div class="x'+(e.ok?"":" red")+'">'+e.html+'</div></div>';
    }
    if(open.length>60) h+='<div class="lede">'+num(open.length-60)+' more open lines in the feed.</div>';
  }
  if(rr.length){
    h+='<div class="secthead" style="margin-top:16px">WHY LINES WERE WITHHELD</div><div class="chips">';
    for(var w=0;w<rr.length;w++) h+='<span class="chip">'+tok(rr[w].why)+'<span class="n">'+num(rr[w].n)+'</span></span>';
    h+='</div>';
  }
  return h;
}
function renderMentorsView(){
  return '<div class="secthead">MENTORS</div>'+
   '<div class="empty">No mentor exists over this record.<br><br>'+
   'Nothing has ever read these lines back to him and answered. '+
   'This pane stays empty rather than inventing a voice.</div>';
}

/* ---------------- view switch ---------------- */
function applyView(){
  var isJ=(view==="Journals"||view==="Archive");
  $("filterwrap").className="filters"+(isJ?"":" hide");
  $("listwrap").className="list"+(isJ?"":" hide");
  $("editorwrap").className="editor"+(isJ?"":" hide");
  var pane=$("pane");
  if(!isJ){
    if(!pane){ pane=document.createElement("section"); pane.id="pane"; pane.className="list";
      $("editorwrap").parentNode.insertBefore(pane,$("editorwrap").nextSibling); }
    pane.className="list";
    pane.innerHTML=(view==="Insights")?renderInsights():renderMentorsView();
  } else if(pane){ pane.className="list hide"; pane.innerHTML=""; }
}

function renderAll(){
  renderNav(); renderChips(); renderList(); renderEditor(); applyView();
  var t=(D&&D.totals)||{};
  var clock=new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});
  $("statusline").textContent="Breath to Life · "+num(t.breaths_qi||0)+" breaths · "+
    num(t.blocks||0)+" blocks · "+clock;
  $("esave").textContent="read-only · screened";
}

/* ---------------- command palette ---------------- */
function renderPalette(){
  var el=$("kmodal");
  if(!kopen){ if(el) el.parentNode.removeChild(el); return; }
  if(!el){
    el=document.createElement("div"); el.id="kmodal"; el.className="modal";
    document.body.appendChild(el);
  }
  var v=visible(), rows="";
  for(var i=0;i<v.length && i<40;i++){
    var b=v[i], d=derive(b), vd=verdict(b.status);
    var ti=d.title!=null? esc(d.title) : "Every line withheld";
    var pv=d.preview!=null? esc(d.preview) : (esc(dateLabel(b.day))+" · "+num(b.n_lines||0)+" lines");
    rows+='<div class="prow" role="button" tabindex="0" data-ts="'+esc(b.ts)+'">'+
      '<span class="av">'+esc((d.title||"○").charAt(0).toUpperCase())+'</span>'+
      '<span class="tx"><span class="t1">'+ti+'</span><span class="t2">'+pv+'</span></span>'+
      '<span class="pill" style="margin-left:0;border-color:'+vd.color+'30;background:'+vd.bg+';color:'+vd.color+'">'+vd.label+'</span>'+
      '</div>';
  }
  if(!v.length) rows='<div class="empty">No block matches &ldquo;'+esc(q)+'&rdquo;.</div>';
  el.innerHTML='<div class="scrim" id="kscrim"></div><div class="panel">'+
    '<div class="gl glasshost"></div>'+
    '<div class="phead">'+
      '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF7F" stroke-width="1.6" style="opacity:.8;flex:0 0 auto"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>'+
      '<input id="kq" placeholder="Search the record…" value="'+esc(q)+'" autocomplete="off" spellcheck="false">'+
      '<span class="esc">ESC</span></div>'+
    '<div class="plist">'+rows+'</div>'+
    '<div class="pfoot"><span>&#8629; to open</span><span class="g"><i></i> screened index</span></div></div>';
  paintGlass(el);
  var ki=$("kq"); if(ki){ ki.focus(); ki.setSelectionRange(ki.value.length,ki.value.length); }
}

/* ---------------- events (delegated: one listener, survives re-render) ---- */
document.addEventListener("click",function(ev){
  var t=ev.target;
  var nb=t.closest?t.closest(".navbtn,.mnav button"):null;
  if(nb&&nb.getAttribute("data-k")){ view=nb.getAttribute("data-k"); renderAll(); return; }
  var ch=t.closest?t.closest("#chips .chip"):null;
  if(ch&&ch.hasAttribute("data-c")){ var c=ch.getAttribute("data-c"); chip=c||null; sel=null; renderAll(); return; }
  var cd=t.closest?t.closest(".card"):null;
  if(cd&&cd.getAttribute("data-ts")){ sel=cd.getAttribute("data-ts"); renderList(); renderEditor(); return; }
  var pr=t.closest?t.closest(".prow"):null;
  if(pr&&pr.getAttribute("data-ts")){ sel=pr.getAttribute("data-ts"); kopen=false; renderPalette(); renderList(); renderEditor(); return; }
  var tl=t.closest?t.closest(".tool"):null;
  if(tl&&tl.getAttribute("data-t")){ say(tl.getAttribute("data-t")); return; }
  if(t.closest&&t.closest("#openk")){ kopen=true; renderPalette(); return; }
  if(t.closest&&t.closest("#kscrim")){ kopen=false; renderPalette(); return; }
  if(t.closest&&t.closest("#newbtn")){ say("This page is the record, not the composer — no write rail is wired."); return; }
  if(t.closest&&t.closest("#qclear")){ q=""; $("q").value=""; $("qclear").className="hide"; renderAll(); return; }
});
$("q").addEventListener("input",function(e){
  q=e.target.value; $("qclear").className=q?"":"hide"; renderList(); renderEditor();
});
document.addEventListener("input",function(e){
  if(e.target&&e.target.id==="kq"){ q=e.target.value; $("q").value=q; renderPalette(); renderList(); renderEditor(); }
});
document.addEventListener("keydown",function(e){
  var k=(e.key||"").toLowerCase();
  if((e.metaKey||e.ctrlKey)&&k==="k"){ e.preventDefault(); kopen=!kopen; renderPalette(); return; }
  if(e.key==="Escape"&&kopen){ kopen=false; renderPalette(); return; }
  if(k==="/"&&!kopen&&document.activeElement!==$("q")){ e.preventDefault(); $("q").focus(); }
});

/* ---------------- live feed: poll, no refresh ---------------- */
function load(first){
  var x=new XMLHttpRequest();
  x.open("GET",FEED+"?t="+Date.now(),true);
  x.onreadystatechange=function(){
    if(x.readyState!==4) return;
    if(x.status>=200&&x.status<300){
      var j=null;
      try{ j=JSON.parse(x.responseText); }catch(err){ j=null; }
      if(j&&j.blocks){
        var changed=(j.generated!==lastGen);
        D=j; lastGen=j.generated||"";
        $("livelbl").textContent="LIVE";
        if(changed||first) renderAll();
        return;
      }
      $("livelbl").textContent="FEED UNREADABLE";
      if(first){ $("etext").innerHTML='<div class="empty">The feed did not parse. Nothing is shown rather than something invented.</div>'; }
      return;
    }
    $("livelbl").textContent="FEED "+(x.status||"OFFLINE");
    if(first){ $("etext").innerHTML='<div class="empty">The feed could not be read ('+esc(x.status||"offline")+'). Nothing is shown rather than something invented.</div>'; }
  };
  x.send();
}
load(true);
setInterval(function(){ load(false); },POLL);
setInterval(function(){
  if(!D) return;
  var t=D.totals||{}, clock=new Date().toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});
  $("statusline").textContent="Breath to Life · "+num(t.breaths_qi||0)+" breaths · "+
    num(t.blocks||0)+" blocks · "+clock;
},30000);
})();
