function tok(s){ return esc(String(s==null?"":s).replace(/[^A-Za-z0-9 _.\-]/g,"").slice(0,40)); }
function num(n){ return (n==null?0:n).toLocaleString(); }

/* ------------------------------------------------------------------ *
 * matrix rain — chars 01/\-_|LIFENOTE, drifting columns, jade low alpha
 * ------------------------------------------------------------------ */
(function(){
  var cv=$("rain"); if(!cv) return;
  var ctx=cv.getContext("2d"); if(!ctx) return;
  var raf=0,cols=0,drops=[];
  var CH="01/\\-_|LIFENOTE".split("");
  function size(){
    cv.width=Math.max(1,Math.floor(cv.offsetWidth*1.5));
    cv.height=Math.max(1,Math.floor(cv.offsetHeight*1.5));
    cols=Math.max(1,Math.floor(cv.width/18));
    var d=new Array(cols);
    for(var i=0;i<cols;i++) d[i]=(drops[i]!==undefined)?drops[i]:Math.random()*-50;
    drops=d;
  }
  size();
  function frame(){
    ctx.fillStyle="rgba(6,8,10,0.18)";
    ctx.fillRect(0,0,cv.width,cv.height);
    ctx.font="14px monospace";
    for(var i=0;i<drops.length;i++){
      var ch=CH[Math.floor(Math.random()*CH.length)];
      var x=i*18, y=drops[i]*18, a=Math.random()*0.6+0.15;
      ctx.fillStyle="rgba(0,255,127,"+(a*0.22)+")";
      ctx.fillText(ch,x,y);
      if(y>cv.height && Math.random()>0.975) drops[i]=0;
      drops[i]+=0.38;
    }
    raf=requestAnimationFrame(frame);
  }
  frame();
  window.addEventListener("resize",size);
})();

