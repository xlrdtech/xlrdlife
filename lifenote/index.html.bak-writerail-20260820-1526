/* the ONE emit boundary. returns {html, ok, why, len} */
function emit(t,cls){
  var raw=(t==null?"":String(t));
  var r=screen(raw);
  if(r[0]) return {html:esc(r[0]),ok:true,why:"ok",len:raw.length,text:r[0]};
  var n=raw.length;
  var msg=n? ("&mdash; withheld ("+n+" chars, "+esc(r[1])+") &mdash;")
